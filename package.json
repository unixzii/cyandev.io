    "build:ssg": "vite build --ssr src/main.ssg.tsx --outDir dist/server && tsx scripts/ssg.ts",
    "build:rss": "tsx scripts/generate-rss.ts",
    "build:vercel": "tsx scripts/build-vercel-output.ts",
    "process-img": "tsx scripts/process-img.ts"
  },
